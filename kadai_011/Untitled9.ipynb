      "source": [
        "array = [\"水\",\"金\",\"地\",\"火\",\"木\",\"土\",\"天\",\"海\",\"冥\"]\n",
        "i = 1\n",
        "for index, value in enumerate(array):\n",
        "    print(f\"{i} : {value}\")\n",
        "    i = i + 1\n",
        "i = 10\n",
        "e = 0\n",
        "while e < 9:\n",
        "    print(f\"{i} : {array[e]}\")\n",
        "    i = i + 1\n",
        "    e = e + 1"
