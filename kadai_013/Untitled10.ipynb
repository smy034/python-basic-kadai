        "def add_two_arguments(price, tax):\n",
        "    # 与えられた引数priceと引数shipping_feeを乗算し、変数totalに代入する\n",
        "    total = price + tax\n",
        "\n",
        "    # 変数$totalの値を出力する\n",
        "    return(f\"{total}円\")\n",
        "\n",
        "# 関数を呼び出し、引数として購入金額と送料を渡す\n",
        "add_two_arguments(110, 10)"
